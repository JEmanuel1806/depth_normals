#version 450 core
layout(local_size_x = 256) in;

struct Point {
    int  pointID;
    vec3 position; float _padA;
    vec3 color;    float _padB;
    vec3 normal;   float _padC;
};

struct NormalStats {
    uint occludedNrml;
    uint goodNrml;
    uint mediumNrml;
    uint badNrml;
};

layout(std430, binding = 1) buffer PointGTBuffer { Point pointsGT[]; };
layout(std430, binding = 2) buffer PointBuf     { Point points[];   };
layout(std430, binding = 3) buffer StatsBuffer  { NormalStats stats; };

uniform uint  uCount;       
uniform float uGoodDeg;     
uniform float uBadDeg;      

bool finite3(vec3 v) {
    return all(lessThan(abs(v), vec3(3.402823e+38))) &&  
           all(equal(v, v));                              
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;

    vec3 n   = points[i].normal;
    vec3 nGT = pointsGT[i].normal;

    if (!finite3(n)   || dot(n,n)   < 1e-12 ||
        !finite3(nGT) || dot(nGT,nGT) < 1e-12) {
        atomicAdd(stats.occludedNrml, 1u);
        return;
    }

    n   = normalize(n);
    nGT = normalize(nGT);

    if (dot(n, nGT) < 0.0) n = -n;

    float d = clamp(dot(n, nGT), -1.0, 1.0);
    float theta = degrees(acos(d)); // 0..180

    if (theta <= uGoodDeg) {
        atomicAdd(stats.goodNrml, 1u);
    } else if (theta <= uBadDeg) {
        atomicAdd(stats.mediumNrml, 1u);
    } else {
        atomicAdd(stats.badNrml, 1u);
    }
}
