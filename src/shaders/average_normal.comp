#version 450 core
layout(local_size_x = 8, local_size_y = 8) in;

uniform isampler2D ref_id;
uniform int maxID;

struct Point {
    int  pointID;
    vec3 position; float _padA;
    vec3 color;    float _padB;
    vec3 normal;   float _padC;
    float splatSize;
};

struct NormalBuffer {
    vec3 normal;
    int counter;
};

struct DensityBuffer {
    float densitySum;
    int counter;
};




//vec3 invisible = vec3(1.0f, 1.0f, 1.0f);

layout(std430, binding = 0) buffer NormalSumBuffer { NormalBuffer normalBuffer[]; }; //normals from previous shader
layout(std430, binding = 2) buffer PointBuffer     { Point points[]; }; //finals normals from this shader
layout(std430, binding = 4) buffer DensitySumBuffer { DensityBuffer densityBuffer[]; };

void main() {
    ivec2 currentPos = ivec2(gl_GlobalInvocationID.xy);
    int currentID = texelFetch(ref_id, currentPos, 0).r;

    if (currentID >= 0 && currentID <= maxID) {

        points[currentID].normal = normalize(normalBuffer[currentID].normal)/(normalBuffer[currentID].counter);

        if (densityBuffer[currentID].counter > 0) {
            float avgDist = densityBuffer[currentID].densitySum / float(densityBuffer[currentID].counter);
        
            float splat = avgDist * 2.0;  
        
            //points[currentID].splatSize = clamp(splat, 1.0, 1000.0);
            points[currentID].splatSize = 2.2;
        }
    }
}
