#version 450 core
layout(local_size_x = 8, local_size_y = 8) in;

uniform isampler2D ref_id;
uniform int maxID;

struct Point {
    int  pointID;
    vec3 position; float _padA;
    vec3 color;    float _padB;
    vec3 normal;   float _padC;
    float splatSize;
};

struct NormalBuffer {
    vec3 normal;
    int counter;
};

struct NormalStats {
    uint occludedNrml;
    uint goodNrml;
    uint mediumNrml;
    uint badNrml;
};

layout(std430, binding = 3) buffer StatsBuffer {
    NormalStats stats;
};

uniform float goodNormal;
uniform float badNormal;

vec3 invisible = vec3(0.141f, 0.149f, 0.192f);

layout(std430, binding = 0) buffer NormalSumBuffer { NormalBuffer normalBuffer[]; };
layout(std430, binding = 1) buffer PointGTBuffer   { Point pointsGT[]; };
layout(std430, binding = 2) buffer PointBuffer     { Point points[]; };

void main() {
    ivec2 currentPos = ivec2(gl_GlobalInvocationID.xy);
    int currentID = texelFetch(ref_id, currentPos, 0).r;

    if (currentID >= 0 && currentID <= maxID) {

        if (normalBuffer[currentID].counter <= 1) {
            atomicAdd(stats.occludedNrml, 1);
            return;
        }

        points[currentID].normal = normalize(
            normalBuffer[currentID].normal / float(normalBuffer[currentID].counter)
        );

        if (any(isnan(points[currentID].normal)) || all(equal(points[currentID].normal, vec3(0.0)))) {   
            points[currentID].color = vec3(1.0f, 0.0f, 0.0f);
            atomicAdd(stats.occludedNrml, 1);
            return;
        }

        float d = clamp(dot(points[currentID].normal, pointsGT[currentID].normal), -1.0, 1.0);
        float cosGood = cos(radians(goodNormal));
        float cosBad  = cos(radians(badNormal));
        
        if (d >= cosGood) {
            atomicAdd(stats.goodNrml, 1);
        }
        else if (d >= cosBad) {
            atomicAdd(stats.mediumNrml, 1);
        }
        else {
            atomicAdd(stats.badNrml, 1);
            points[currentID].color = vec3(1.0, 0.0, 0.0);
        }
    }
}
